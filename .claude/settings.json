{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor|PowerShell|Read|Edit|Write|MultiEdit|NotebookEdit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"/usr/local/bin:/opt/homebrew/bin:$PATH\" node \"$CLAUDE_PROJECT_DIR/scripts/fabrica/hook-pre-tool-use.mjs\" || exit 2",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run test)",
      "Bash(npx tsc --noEmit)",
      "Bash(NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=placeholder NEXT_TELEMETRY_DISABLED=1 npm run build)",
      "Bash(npm ci)",
      "Bash(npm ci --prefer-offline --no-audit --no-fund)",
      "Bash(npm audit --omit=dev)",
      "Bash(git fetch origin)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse --show-toplevel)",
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff HEAD)",
      "Bash(git log --oneline -10)",
      "Bash(git stash list)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)"
    ]
  }
}
